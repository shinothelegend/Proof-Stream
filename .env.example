# ==============================================================================
# ProofStream — Environment Configuration Example (.env.example)
# Network: Base Sepolia (Chain ID: 84532)
# Copy this file to .env and populate with your own API keys & testnet signers.
# DO NOT commit real secrets or private keys to source control.
# ==============================================================================

# ── Blockchain: Base Sepolia (84532) ───────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=84532                                  # Target Chain ID for Base Sepolia testnet
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org                # Base Sepolia public RPC endpoint
NEXT_PUBLIC_BLOCK_EXPLORER=https://sepolia.basescan.org     # BaseScan explorer URL for transaction deep links
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e # Canonical Circle testnet USDC on Base Sepolia
NEXT_PUBLIC_ESCROW_ADDRESS=                                 # Deployed CampaignEscrow.sol contract address (0x...)
NEXT_PUBLIC_EAS_ADDRESS=0x4200000000000000000000000000000000000021 # Canonical OP-Stack EAS Predeploy contract
NEXT_PUBLIC_SCHEMA_REGISTRY=0x4200000000000000000000000000000000000020 # Canonical OP-Stack EAS Schema Registry Predeploy
NEXT_PUBLIC_EAS_SCHEMA_UID=                                 # Registered EAS Schema UID for ProofStream impact attestations (0x...)
VERIFIER_PRIVATE_KEY=                                       # Base Sepolia private key (0x... 64-hex) for autonomous verifier signer (backend only)
DEPLOYER_PRIVATE_KEY=                                       # Base Sepolia private key (0x... 64-hex) for deployer/admin account (backend/foundry only)

# ── AI Verification Agent (Google Gemini) ─────────────────────────────────────
GEMINI_API_KEY=                                             # Google AI Studio API key for multimodal vision & receipt OCR
GEMINI_MODEL=gemini-2.5-flash                               # Gemini multimodal model identifier (e.g. gemini-2.5-flash)

# ── Decentralized Storage (Pinata IPFS) ─────────────────────────────────────────
PINATA_JWT=                                                 # Pinata API JWT Bearer token for immutable field evidence pinning
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud     # Dedicated or public Pinata IPFS gateway URL

# ── Application & Database ─────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"                                # SQLite database connection string for Prisma
NEXT_PUBLIC_APP_URL=http://localhost:3000                   # Application origin URL (used for phone QR camera capture reachability)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=                       # Reown / WalletConnect Cloud Project ID (get free at cloud.reown.com)
REVIEW_TOKEN=proofstream_review_pass_2026                   # Secret bearer token for auditor queue authorization
